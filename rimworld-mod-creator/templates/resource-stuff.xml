<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  模板类型: 原材料/建筑材料 ThingDef（Stuff 类型）
  验证状态: 已验证 —— 参考原版 StuffCategories 与 Resources
  生成方式: AI 辅助生成
  原版参考路径:
    - Core/Defs/ThingDefs_Misc/Items/Items_Resource_Stuff.xml
    - Core/Defs/ThingDefs_Misc/Items/Items_Resource_Stuff_Leather.xml
  ParentName 继承链:
    ResourceBase  <-- 本模板使用此 ParentName
  关键设计决策:
    1. ResourceBase 已内置以下内容:
       - CompProperties_Forbiddable (可禁止)
       - 默认 drawGUIOverlay（数量显示）
       - 默认 category = Item
    2. stuffProps 是核心节点，定义该材料作为 Stuff 时的属性。
    3. stuffStatFactors 是乘数（<1 = 降低该属性，>1 = 提升）。
    4. stuffStatOffsets 是加数（正值 = 增加该属性，负值 = 减少）。
    5. color 和 colorOffset 决定使用该材料制作的物品的颜色。
  使用方法:
    - 将所有 <Your...> 占位符替换为实际值
    - stuffProps.categories 决定此材料可被哪些物品使用
    - 删除不需要的可选节点和注释
  ============================================================
-->
<Defs>

  <ThingDef ParentName="ResourceBase">
    <!-- defName: 必须全局唯一，建议加模组前缀 -->
    <defName><YourDefName></defName>

    <!-- label: 游戏内显示名称 -->
    <label><YourLabel></label>

    <!-- description: 游戏内描述文本 -->
    <description><YourDescription></description>

    <!-- stackLimit: 单个堆叠最大数量（原版常用 75 / 150 / 300 / 500） -->
    <stackLimit>75</stackLimit>

    <!-- statBases: 基础属性 -->
    <statBases>
      <!-- MaxHitPoints: 最大耐久度 -->
      <MaxHitPoints>50</MaxHitPoints>
      <!-- MarketValue: 单个市场价值 -->
      <MarketValue>2.0</MarketValue>
      <!-- Flammability: 可燃性（0=不可燃，1=易燃） -->
      <Flammability>1.0</Flammability>
      <!-- DeteriorationRate: 露天放置时的老化速率（0=不老化） -->
      <DeteriorationRate>2</DeteriorationRate>
      <!-- Mass: 单个重量 -->
      <Mass>0.05</Mass>
      <!-- Beauty: 美观度（负值=丑陋，正值=美观） -->
      <Beauty>0</Beauty>
    </statBases>

    <!--
      stuffProps: 材料属性定义（核心节点）
      - categories: 材料类别，决定此材料可用于哪些物品
          Metallic  - 金属类（武器、护甲、建筑等）
          Woody     - 木材类
          Stony     - 石材类
          Leathery  - 皮革类（服装）
          Fabric    - 布料类（服装）
          Plastel   - 塑料类（DLC）
      - commonality: 材料在随机生成时的稀有度（越大越常见）
      - stuffAdjective: 材料形容词（如 "steel" -> "steel sword" 钢剑）
      - color: 材料基础颜色（RGBA 或 RGB）
      - colorOffset: 颜色偏移（加算到基础颜色上）
      - constructEffect: 建造时的特效 defName（可选）
      - receiptishFactor: 作为制作材料时的成本系数（可选，通常为 1）
      - stuffStatFactors: 属性乘数（对该材料制作的物品属性进行乘算）
      - stuffStatOffsets: 属性加成（对该材料制作的物品属性进行加算）
    -->
    <stuffProps>
      <categories>
        <li>Metallic</li>
      </categories>
      <commonality>0.5</commonality>
      <stuffAdjective><YourAdjective></stuffAdjective>
      <color>(180,180,180)</color>
      <colorOffset>(0,0,0,0)</colorOffset>
      <constructEffect>ConstructMetal</constructEffect>
      <receiptishFactor>1</receiptishFactor>

      <!--
        stuffStatFactors: 属性乘数
        以下为常见乘数属性（值 < 1 表示降低，> 1 表示提升）:
        - MaxHitPoints        - 最大耐久度
        - ArmorRating_Sharp   - 锐器护甲
        - ArmorRating_Blunt   - 钝器护甲
        - ArmorRating_Heat    - 热能护甲
        - Flammability        - 可燃性
        - Beauty              - 美观度
        - WorkToMake          - 制作工作量
        - WorkToBuild         - 建造工作量
        - Mass                - 重量
        - Insulation_Cold     - 寒冷隔热
        - Insulation_Heat     - 炎热隔热
        - DeteriorationRate   - 老化速率
        - SharpDamageMultiplier   - 锐器伤害倍率
        - BluntDamageMultiplier   - 钝器伤害倍率
      -->
      <stuffStatFactors>
        <MaxHitPoints>1.2</MaxHitPoints>
        <ArmorRating_Sharp>1.5</ArmorRating_Sharp>
        <ArmorRating_Blunt>1.2</ArmorRating_Blunt>
        <Flammability>0.2</Flammability>
        <Beauty>1</Beauty>
        <WorkToMake>1.5</WorkToMake>
        <WorkToBuild>1.5</WorkToBuild>
        <Mass>1.2</Mass>
        <SharpDamageMultiplier>1.1</SharpDamageMultiplier>
        <BluntDamageMultiplier>1.0</BluntDamageMultiplier>
      </stuffStatFactors>

      <!--
        stuffStatOffsets: 属性加成（直接加到物品属性上）
        常见加成属性:
        - ArmorRating_Sharp / ArmorRating_Blunt / ArmorRating_Heat
        - Insulation_Cold / Insulation_Heat
        - Beauty / MoveSpeed
      -->
      <stuffStatOffsets>
        <ArmorRating_Sharp>0.05</ArmorRating_Sharp>
        <ArmorRating_Blunt>0.03</ArmorRating_Blunt>
        <Insulation_Cold>1</Insulation_Cold>
      </stuffStatOffsets>
    </stuffProps>

    <!--
      graphicData: 图形显示配置
      - texPath: 贴图路径（相对于 Textures/ 文件夹，不含扩展名）
      - graphicClass: Graphic_Single 表示单张静态图
      - shaderType: CutoutComplex 支持材质颜色染色
    -->
    <graphicData>
      <texPath>Things/Item/Resource/<YourTexPath></texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>

    <!-- thingCategories: 物品分类（原材料统一用 ResourcesRaw） -->
    <thingCategories>
      <li>ResourcesRaw</li>
    </thingCategories>

    <!--
      resourceReadoutPriority: 资源面板显示优先级
        First   - 优先显示
        Middle  - 中间显示
        Last    - 最后显示
    -->
    <resourceReadoutPriority>Middle</resourceReadoutPriority>

    <!-- smallVolume: 是否为小体积物品（影响搬运批量） -->
    <smallVolume>true</smallVolume>

    <!--
      allowedArchonexusCount: 允许在大天使方舟迁移时携带的数量上限
      -1 表示不限制，0 表示不可携带，正值表示具体上限
    -->
    <allowedArchonexusCount>200</allowedArchonexusCount>

  </ThingDef>

</Defs>
